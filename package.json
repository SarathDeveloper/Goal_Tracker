{
  "name": "goal-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Personal goal tracker for goals, milestones, habits, and reminders",
  "productName": "Goal Tracker",
  "author": "Goal Tracker",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently --names vite,api \"vite\" \"tsx watch --tsconfig tsconfig.server.json server/index.ts\"",
    "server": "tsx watch --tsconfig tsconfig.server.json server/index.ts",
    "build": "vite build",
    "start": "tsx --tsconfig tsconfig.server.json server/index.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "sidecar:package": "node scripts/build-sidecar.mjs && node scripts/package-sidecar.mjs",
    "desktop:prepare": "npm run build && npm run sidecar:package && node scripts/prepare-tauri-resources.mjs",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:build": "npm run desktop:prepare && node scripts/run-tauri.mjs build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.9.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.9",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postject": "1.0.0-alpha.6",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
