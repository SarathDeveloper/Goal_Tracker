{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goal Tracker",
  "version": "1.0.0",
  "identifier": "com.goaltracker.desktop",
  "build": {
    "frontendDist": "splash",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/goaltracker-api"],
    "resources": [
      "resources/package.json",
      "resources/dist",
      "resources/migrations",
      "resources/better-sqlite3-win32-x64.node",
      "binaries/*.node"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
